# Copie este archivo a .env y complete los valores. Nunca confirme .env en Git.
# Los nombres deben coincidir exactamente con los campos de app/core/config.py:Settings.

# ==============================
# CONFIGURACIÓN GENERAL
# ==============================
SCAN_INTERVAL_SECONDS=60
PAIR_DELAY_SECONDS=0

# ==============================
# METATRADER 5 (sesión del terminal, horarios de mercado)
# ==============================
# No se almacenan credenciales de MT5 aquí: la librería usa la sesión ya
# autenticada en la terminal instalada localmente.
MT5_TIMEZONE=UTC
SYSTEM_TIMEZONE=UTC
TRADING_TIMEZONE=UTC
SESSION_START=06:00
SESSION_END=18:00
ROLLOVER_BLOCK_START=21:55
ROLLOVER_BLOCK_END=22:15

# ==============================
# MT5 — RECONEXIÓN, TIMEOUTS Y FRESCURA DE DATOS (Fase 3)
# ==============================
# Backoff exponencial con jitter para reconectar tras una caída del terminal o
# del broker: 5s, 10s, 20s, 40s, 60s (tope), nunca instantáneo ni sin límite.
MT5_RECONNECT_INITIAL_DELAY_SECONDS=5
MT5_RECONNECT_MAX_DELAY_SECONDS=60
MT5_RECONNECT_BACKOFF_MULTIPLIER=2
# Tiempo máximo de espera para conectar y para una consulta individual. MT5 no
# ofrece una forma nativa de cancelar una llamada bloqueada: superado el timeout,
# la conexión se marca DEGRADED en vez de reintentar sobre un hilo aún ocupado.
MT5_CONNECT_TIMEOUT_SECONDS=15
MT5_REQUEST_TIMEOUT_SECONDS=10
# Antigüedad máxima aceptada del último tick y de la última vela cerrada
# (como múltiplo de la duración del timeframe) antes de rechazar una señal por
# datos obsoletos. No se aplica cuando el mercado está cerrado normalmente.
MT5_MAX_TICK_AGE_SECONDS=120
MT5_STALE_BAR_AGE_MULTIPLIER=3.0

# ==============================
# TELEGRAM
# ==============================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEBUG_HOLD=false
TELEGRAM_MAX_RETRIES=3

# ==============================
# PARES DE DIVISAS
# ==============================
FOREX_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD

# ==============================
# TEMPORALIDADES
# ==============================
LOWER_TIMEFRAME=M15
HIGHER_TIMEFRAME=H1
LOWER_TIMEFRAME_BARS=300
HIGHER_TIMEFRAME_BARS=300

# ==============================
# INDICADORES
# ==============================
TREND_EMA_FAST=50
TREND_EMA_SLOW=200
ENTRY_EMA_FAST=20
ENTRY_EMA_SLOW=50
RSI_PERIOD=14
ATR_PERIOD=14
ADX_PERIOD=14
MIN_ADX=20
MAX_ADX=45
RSI_BUY_TRIGGER=52
RSI_SELL_TRIGGER=48

# ==============================
# FILTROS DE ESTRATEGIA
# ==============================
PULLBACK_DISTANCE_ATR_MULT=0.20
MIN_BODY_ATR_MULT=0.25
MAX_PRICE_EMA_DISTANCE_ATR_MULT=1.20
MIN_VOLATILITY_RATIO=0.0001
STOP_BUFFER_ATR_MULT=0.25
SWING_LOOKBACK_BARS=7
MIN_STOP_ATR_MULT=0.50
MAX_STOP_ATR_MULT=2.50
RISK_REWARD_RATIO=2.0
SETUP_EXPIRATION_BARS=4
MIN_SIGNAL_SCORE=75
MAX_SPREAD_ATR_RATIO=0.10
MAX_CORRELATED_SIGNALS=1
BACKTEST_DEFAULT_SPREAD_POINTS=20
